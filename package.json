{
  "name": "@advantech-axa/nemoclaw-deploy",
  "version": "0.0.9",
  "description": "Install and onboard NemoClaw, then safely deploy one or more OpenClaw agents.",
  "type": "module",
  "bin": {
    "nemoclaw-deploy": "./bin/nemoclaw-deploy.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:compat": "npm run build && node --test test/nemoclaw-compat.test.mjs",
    "bundle:iems": "npm run build && node scripts/build-iems-bundle.mjs",
    "test:bundle": "node test/bundle-smoke.mjs",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "preinstall": "node bin/check-node-version.cjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.8.0",
    "commander": "^14.0.2",
    "execa": "^9.6.0",
    "fs-extra": "^11.3.2",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.10.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
